{
  "name": "@wszerad/items",
  "version": "0.3.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck && npm run bundle",
    "typecheck": "tsgo -p tsconfig.json",
    "bundle": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "lint:format": "oxlint src && oxfmt --check src",
    "format": "oxfmt src"
  },
  "dependencies": {
    "ohash": "^2.0.11"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@typescript/native-preview": "^7.0.0-dev.20251231.1",
    "oxfmt": "^0.21.0",
    "oxlint": "^1.38.0",
    "tsdown": "^0.18.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "array",
    "diff",
    "ohash",
    "immutable"
  ],
  "author": "Wszerad Martynowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wszerad/items.git"
  },
  "license": "MIT"
}
